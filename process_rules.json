{
  "version": "2.1",
  "description": "CryptoVeil MITRE ATT&CK Process Behavior Rule Set",
  "rules": [
    {
      "id": "CV-BROWSER-SHELL-001",
      "mitre_id": "T1059",
      "mitre_name": "Command and Scripting Interpreter",
      "severity": "high",
      "description": "A browser directly launched a command interpreter; review whether the handoff was authorised.",
      "conditions": {
        "process_name_in": [
          "powershell.exe",
          "pwsh.exe",
          "cmd.exe",
          "mshta.exe",
          "wscript.exe",
          "cscript.exe"
        ],
        "parent_name_in": [
          "chrome.exe",
          "msedge.exe",
          "brave.exe",
          "opera.exe",
          "firefox.exe"
        ]
      }
    },
    {
      "id": "CV-ENCODED-POWERSHELL-001",
      "mitre_id": "T1059.001",
      "mitre_name": "PowerShell",
      "severity": "medium",
      "description": "PowerShell received an encoded-command argument; verify the script's purpose and authorisation.",
      "conditions": {
        "process_name_in": ["powershell.exe", "pwsh.exe"],
        "cmdline_regex": "(?:^|\\s)-(?:e|en|enc|enco|encodedcommand)\\s+[A-Za-z0-9+/=]{8,}"
      }
    },
    {
      "id": "CV-LINEAGE-001",
      "mitre_id": "T1036.005",
      "mitre_name": "Masquerading: Match Legitimate Name",
      "severity": "medium",
      "description": "Unexpected svchost.exe parent lineage; review for masquerading. This does not prove process hollowing.",
      "conditions": {
        "process_name_in": ["svchost.exe"],
        "parent_name_not_in": ["services.exe", "svchost.exe", "wininit.exe"]
      }
    },
    {
      "id": "CV-T1059-001",
      "mitre_id": "T1059",
      "mitre_name": "Command and Scripting Interpreter",
      "severity": "high",
      "description": "A shell was launched by an Office application; review whether this was expected.",
      "conditions": {
        "process_name_in": ["powershell.exe", "pwsh.exe", "cmd.exe"],
        "parent_name_in": [
          "winword.exe",
          "excel.exe",
          "powerpnt.exe",
          "outlook.exe",
          "onenote.exe"
        ]
      }
    },
    {
      "id": "CV-T1047-001",
      "mitre_id": "T1047",
      "mitre_name": "Windows Management Instrumentation",
      "severity": "high",
      "description": "Shell process spawned by wmiprvse.exe (WMI lateral movement indicator)",
      "conditions": {
        "process_name_in": [
          "cmd.exe",
          "powershell.exe",
          "pwsh.exe",
          "wscript.exe",
          "cscript.exe"
        ],
        "parent_name_in": ["wmiprvse.exe"]
      }
    },
    {
      "id": "CV-T1218-005",
      "mitre_id": "T1218.005",
      "mitre_name": "System Binary Proxy: Mshta",
      "severity": "high",
      "description": "mshta.exe launched with a remote URL argument (LOLBin abuse)",
      "conditions": {
        "process_name_in": ["mshta.exe"],
        "cmdline_regex": "https?://"
      }
    },
    {
      "id": "CV-T1218-010",
      "mitre_id": "T1218.010",
      "mitre_name": "System Binary Proxy: Regsvr32",
      "severity": "high",
      "description": "regsvr32.exe used with scrobj.dll or remote URL (Squiblydoo attack)",
      "conditions": {
        "process_name_in": ["regsvr32.exe"],
        "cmdline_regex": "(scrobj|https?://)"
      }
    },
    {
      "id": "CV-T1036-005",
      "mitre_id": "T1036.005",
      "mitre_name": "Masquerading: Match Legitimate Name",
      "severity": "medium",
      "description": "Known-safe binary name running from a non-standard path (masquerading)",
      "conditions": {
        "process_name_in": [
          "svchost.exe",
          "lsass.exe",
          "csrss.exe",
          "winlogon.exe"
        ],
        "exe_path_not_contains": [
          "\\Windows\\System32\\",
          "\\Windows\\SysWOW64\\"
        ]
      }
    },
    {
      "id": "CV-T1003-001",
      "mitre_id": "T1003.001",
      "mitre_name": "Credential Dumping: LSASS Memory",
      "severity": "critical",
      "description": "A known tool references LSASS memory dumping; review command-line evidence.",
      "conditions": {
        "process_name_in": [
          "procdump.exe",
          "procdump64.exe",
          "rundll32.exe",
          "mimikatz.exe"
        ],
        "cmdline_regex": "(lsass(?:\\.exe)?\\b|mimikatz|comsvcs(?:\\.dll)?.*MiniDump)"
      }
    },
    {
      "id": "CV-T1059-003",
      "mitre_id": "T1059.003",
      "mitre_name": "Command and Scripting: Windows Command Shell",
      "severity": "medium",
      "description": "cmd.exe with encoded or piped commands suggesting script execution",
      "conditions": {
        "process_name_in": ["cmd.exe"],
        "cmdline_regex": "(/c\\s+|/k\\s+).*(powershell|wscript|mshta|certutil)"
      }
    }
  ]
}
